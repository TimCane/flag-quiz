{
  "name": "@flag-quiz/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc && node --env-file=../../.env dist/index.js",
    "dev:watch": "tsx --env-file=../../.env watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flag-quiz/shared": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
